  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    import ComposicaoProdutoCampos from "./ComposicaoProdutoCampos";
    import { prepararComposicao, type LinhaComposicao } from "./composicaoProduto";
    import ClassificacaoProdutoCampos from "./ClassificacaoProdutoCampos";
    import { type ClassificacaoProduto } from "./classificacaoProdutoUtils";
    import {useEffect, useRef, useState, type ChangeEvent, type FormEvent} from "react";
    import api from "../../services/api";
    import {
        Alert,
        Button,
        Box,
        CircularProgress,
        Dialog,
        DialogActions,
        DialogContent,
        DialogTitle,
        Divider,
        FormControlLabel,
        IconButton,
        Radio,
        RadioGroup,
        Stack,
        Switch,
        Tab,
        Tabs,
        TextField,
        Typography,
    } from "@mui/material";
    import AddRoundedIcon from "@mui/icons-material/AddRounded";
    import DeleteOutlineRoundedIcon from "@mui/icons-material/DeleteOutlineRounded";
    import CadastroDialog from "../../components/ui/CadastroDialog";
    import type {Produto, ProdutoFornecedorVinculoInput, ProdutoInput} from "../../types/produto";
    import {cadastrarProduto, listarKitsDependentes, obterMensagemDaApi, type KitDependente} from "../../services/produtoService";
    import FornecedorAutocomplete, { type FornecedorOpcao } from "../../components/fornecedores/FornecedorAutocomplete";

    type ProdutoFormProps = {
        aberto: boolean;
        onFechar: () => void;
    } & ({
        modo?: "completo";
        produto: Produto | null;
        duplicando?: boolean;
        carregandoProduto: boolean;
        salvando: boolean;
        erroExterno: string;
        onSalvar: (dados: ProdutoInput, arquivoImagem: File | null, removerImagem: boolean) => Promise<void>;
        dadosIniciais?: never;
        onSalvo?: never;
    } | {
        modo: "rapido";
        duplicando?: never;
        dadosIniciais?: Partial<Pick<ProdutoInput, "nome" | "codigoBarras" | "unidadeMedida" | "precoCusto">>;
        onSalvo: (produto: Produto) => void;
        produto?: never;
        carregandoProduto?: never;
        salvando?: never;
        erroExterno?: never;
        onSalvar?: never;
    });

    type EstadoFormulario = {
        codigoInterno: string;
        codigoBarras: string;
        ncm: string;
        cest: string;
        nome: string;
        descricao: string;
        unidadeMedida: string;
        precoCusto: string;
        precoVenda: string;
        estoqueMinimo: string;
        controlaEstoque: boolean;
        ativo: boolean;
    };

    type LinhaVinculo = {
        fornecedor: FornecedorOpcao | null;
        codigoReferencia: string;
        /** 1 embalagem comprada = X unidades do produto. Vazio = sem conversão (1:1). */
        fatorConversao: string;
    };

    // Abas do cadastro completo, por responsabilidade: padrão reutilizável para futuros cadastros.
    const ABAS = ["Dados gerais", "Preços e estoque", "Fornecedores", "Kit/Combo", "Fiscal"] as const;

    const estadoInicial: EstadoFormulario = {
        codigoInterno: "",
        codigoBarras: "",
        ncm: "",
        cest: "",
        nome: "",
        descricao: "",
        unidadeMedida: "UN",
        precoCusto: "0,00",
        precoVenda: "",
        estoqueMinimo: "0,000",
        controlaEstoque: true,
        ativo: true,
    };

    function criarEstadoFormulario(produto: Produto | null, duplicando = false): EstadoFormulario {
        if (!produto) return estadoInicial;

        return {
            codigoInterno: duplicando ? "" : produto.codigoInterno ?? "",
            codigoBarras: duplicando ? "" : produto.codigoBarras ?? "",
            ncm: produto.ncm ?? "",
            cest: produto.cest ?? "",
            nome: produto.nome,
            descricao: produto.descricao ?? "",
            unidadeMedida: produto.unidadeMedida,
            precoCusto: numeroParaCampo(duplicando && produto.composto ? 0 : produto.precoCusto, 2),
            precoVenda: numeroParaCampo(produto.precoVenda, 2),
            estoqueMinimo: numeroParaCampo(produto.estoqueMinimo, 3),
            controlaEstoque: produto.controlaEstoque,
            ativo: duplicando ? true : produto.ativo,
        };
    }

    function numeroParaCampo(valor: number, casas: number): string {
        return Number(valor).toFixed(casas).replace(".", ",");
    }

    function campoParaNumero(
        valor: string,
        maximoCasasDecimais: number
    ): number | null {
        const normalizado = valor.trim().replace(",", ".");

        if (!normalizado || !/^\d+(\.\d+)?$/.test(normalizado)) {
            return null;
        }

        const casasDecimais = normalizado.split(".")[1]?.length ?? 0;

        if (casasDecimais > maximoCasasDecimais) {
            return null;
        }

        const numero = Number(normalizado);

        return Number.isFinite(numero) ? numero : null;
    }

    function ProdutoForm({
                             aberto,
                             modo = "completo",
                             produto = null,
                             duplicando = false,
                             carregandoProduto = false,
                             salvando: salvandoExterno = false,
                             erroExterno = "",
                             dadosIniciais,
                             onFechar,
                             onSalvar,
                             onSalvo,
                         }: ProdutoFormProps) {
        const rapido = modo === "rapido";
        const [suportaKit, setSuportaKit] = useState(false);
        useEffect(() => {
            if (rapido) return;
            const c=new AbortController();
            api.get<{habilitado:boolean}>("/produtos/composicao/capacidade",{signal:c.signal})
                .then(r=>{if(!c.signal.aborted)setSuportaKit(r.data.habilitado===true);}).catch(()=>{});
            return ()=>c.abort();
        },[rapido]);
        const [composto, setComposto] = useState(!!produto?.composto && !duplicando);
        const [componentes, setComponentes] = useState<LinhaComposicao[] | null>(produto?.composto && !duplicando ? null : []);
        const [formulario, setFormulario] = useState<EstadoFormulario>(() =>
            rapido ? {
                ...estadoInicial,
                nome: dadosIniciais?.nome ?? "",
                codigoBarras: dadosIniciais?.codigoBarras ?? "",
                unidadeMedida: dadosIniciais?.unidadeMedida ?? "UN",
                precoCusto: String(dadosIniciais?.precoCusto ?? 0).replace(".", ","),
            } : criarEstadoFormulario(produto, duplicando)
        );
        const [codigoAutomatico, setCodigoAutomatico] = useState(duplicando);
        const [salvandoRapido, setSalvandoRapido] = useState(false);
        const [fornecedor, setFornecedor] = useState<FornecedorOpcao | null>(produto?.fornecedor ?? null);
        const [classificacao, setClassificacao] = useState<ClassificacaoProduto>({ categoria: produto?.categoria ?? null, subcategoria: produto?.subcategoria ?? null, marca: produto?.marca ?? null });
        const [erroRapido, setErroRapido] = useState("");
        const [abaAtual, setAbaAtual] = useState(0);
        // Duplicação não copia os vínculos adicionais: o código de referência é específico do vínculo original.
        const [vinculos, setVinculos] = useState<LinhaVinculo[]>(() =>
            !rapido && !duplicando
                ? (produto?.fornecedoresAdicionais ?? []).map((v) => ({
                    fornecedor: v.fornecedor,
                    codigoReferencia: v.codigoReferencia ?? "",
                    fatorConversao: v.fatorConversao != null ? String(v.fatorConversao) : "",
                }))
                : []
        );
        const [erroVinculos, setErroVinculos] = useState("");
        const ocupado = useRef(false);
        const salvando = salvandoExterno || salvandoRapido;
        const mensagemErro = erroExterno || erroRapido;
        const editando = produto !== null && !duplicando;

        // Kits/Combos cuja composição vigente usa este produto como componente.
        const [kitsDependentes, setKitsDependentes] = useState<KitDependente[] | null>(null);
        // Alteração crítica aguardando confirmação do operador.
        const [pendencia, setPendencia] = useState<null | { campo: "controlaEstoque" | "ativo"; valor: boolean }>(null);

        useEffect(() => {
            if (!aberto || rapido || !editando || !produto) return;
            const controle = new AbortController();
            listarKitsDependentes(produto.id, controle.signal)
                .then((lista) => { if (!controle.signal.aborted) setKitsDependentes(lista); })
                .catch(() => { if (!controle.signal.aborted) setKitsDependentes([]); });
            return () => controle.abort();
        }, [aberto, rapido, editando, produto]);

        const [erros, setErros] = useState<
            Partial<Record<keyof EstadoFormulario, string>>
        >({});

        const [arquivoImagem, setArquivoImagem] = useState<File | null>(null);
        const [previewImagem, setPreviewImagem] = useState<string | null>(duplicando ? null : produto?.imagemUrl ?? null);
        const [imagemRemovida, setImagemRemovida] = useState(false);

        function alterarCampo<K extends keyof EstadoFormulario>(
            campo: K,
            valor: EstadoFormulario[K]
        ) {
            setFormulario((atual) => ({
                ...atual,
                [campo]: valor,
            }));

            setErros((atual) => ({
                ...atual,
                [campo]: undefined,
            }));
        }

        function confirmarPendencia() {
            if (pendencia) alterarCampo(pendencia.campo, pendencia.valor);
            setPendencia(null);
        }

        function alterarControlaEstoque(ligado: boolean) {
            if (!ligado && editando && !rapido && formulario.controlaEstoque) {
                setPendencia({ campo: "controlaEstoque", valor: false });
                return;
            }
            alterarCampo("controlaEstoque", ligado);
        }

        function alterarAtivo(ligado: boolean) {
            if (!ligado && editando && !rapido && formulario.ativo) {
                setPendencia({ campo: "ativo", valor: false });
                return;
            }
            alterarCampo("ativo", ligado);
        }

        function selecionarImagem(evento: ChangeEvent<HTMLInputElement>) {
            const arquivo = evento.target.files?.[0];

            if (!arquivo) {
                return;
            }

            if (!arquivo.type.startsWith("image/")) {
                return;
            }

            if (arquivo.size > 2 * 1024 * 1024) {
                return;
            }

            setArquivoImagem(arquivo);
            setImagemRemovida(false);

            const leitor = new FileReader();

            leitor.onload = () => {
                setPreviewImagem(leitor.result as string);
            };

            leitor.readAsDataURL(arquivo);
        }

        function removerImagem() {
            setArquivoImagem(null);
            setPreviewImagem(null);
            setImagemRemovida(true);
        }

        function atualizarVinculo(indice: number, parte: Partial<LinhaVinculo>) {
            setVinculos((atual) => atual.map((linha, i) => (i === indice ? { ...linha, ...parte } : linha)));
            setErroVinculos("");
        }

        function adicionarVinculo() {
            setVinculos((atual) => [...atual, { fornecedor: null, codigoReferencia: "", fatorConversao: "" }]);
        }

        function removerVinculo(indice: number) {
            setVinculos((atual) => atual.filter((_, i) => i !== indice));
            setErroVinculos("");
        }

        function validar(): ProdutoInput | null {
            const novosErros: Partial<
                Record<keyof EstadoFormulario, string>
            > = {};

            const precoCusto = campoParaNumero(formulario.precoCusto, 2);
            const precoVenda = campoParaNumero(formulario.precoVenda, 2);
            const estoqueMinimo = campoParaNumero(
                formulario.estoqueMinimo,
                3
            );

            if (!formulario.nome.trim()) {
                novosErros.nome = "Informe o nome do produto.";
            }

            if (formulario.nome.trim().length > 150) {
                novosErros.nome = "Use no máximo 150 caracteres.";
            }

            if (!formulario.unidadeMedida.trim()) {
                novosErros.unidadeMedida = "Informe a unidade de medida.";
            }

            if (formulario.unidadeMedida.trim().length > 10) {
                novosErros.unidadeMedida = "Use no máximo 10 caracteres.";
            }

            if (formulario.codigoInterno.length > 60) {
                novosErros.codigoInterno = "Use no máximo 60 caracteres.";
            }
            if (duplicando && !codigoAutomatico && !formulario.codigoInterno.trim()) {
                novosErros.codigoInterno = "Informe um código interno válido.";
            }
            if (formulario.codigoInterno.trim() && !/[\p{L}\p{N}]/u.test(formulario.codigoInterno)) {
                novosErros.codigoInterno = "Informe um código interno válido.";
            }

            if (formulario.codigoBarras.length > 60) {
                novosErros.codigoBarras = "Use no máximo 60 caracteres.";
            }
            if (formulario.ncm && !/^\d{8}$/.test(formulario.ncm)) novosErros.ncm = "NCM deve conter 8 dígitos.";
            if (formulario.cest && !/^\d{7}$/.test(formulario.cest)) novosErros.cest = "CEST deve conter 7 dígitos.";

            if (formulario.descricao.length > 2000) {
                novosErros.descricao = "Use no máximo 2000 caracteres.";
            }

            if (precoCusto === null) {
                novosErros.precoCusto =
                    "Use um valor não negativo com até 2 casas decimais.";
            }

            if (precoVenda === null) {
                novosErros.precoVenda =
                    "Use um valor não negativo com até 2 casas decimais.";
            }

            if (
                formulario.controlaEstoque &&
                estoqueMinimo === null
            ) {
                novosErros.estoqueMinimo =
                    "Use uma quantidade não negativa com até 3 casas decimais.";
            }

            setErros(novosErros);

            if (
                Object.keys(novosErros).length > 0 ||
                precoCusto === null ||
                precoVenda === null ||
                (formulario.controlaEstoque &&
                    estoqueMinimo === null)
            ) {
                if (!rapido) {
                    if (novosErros.ncm || novosErros.cest) setAbaAtual(4);
                    else if ((["unidadeMedida", "precoCusto", "precoVenda", "estoqueMinimo"] as const).some((c) => novosErros[c])) setAbaAtual(1);
                    else setAbaAtual(0);
                }
                return null;
            }

            let composicao;
            try { if (composto && componentes !== null) composicao=prepararComposicao(componentes); }
            catch (e) {
                if (!rapido) setAbaAtual(3);
                setErroRapido(e instanceof Error ? e.message : "Composicao invalida.");
                return null;
            }

            const vinculosValidos: ProdutoFornecedorVinculoInput[] = [];
            if (!rapido) {
                const vistos = new Set<number>();
                for (const linha of vinculos) {
                    if (!linha.fornecedor) {
                        setErroVinculos("Informe o fornecedor de cada vínculo adicional ou remova a linha.");
                        setAbaAtual(2);
                        return null;
                    }
                    if (vistos.has(linha.fornecedor.id)) {
                        setErroVinculos("O mesmo fornecedor aparece mais de uma vez nos vínculos adicionais.");
                        setAbaAtual(2);
                        return null;
                    }
                    vistos.add(linha.fornecedor.id);
                    if (linha.codigoReferencia.length > 60) {
                        setErroVinculos("Use no máximo 60 caracteres no código de referência.");
                        setAbaAtual(2);
                        return null;
                    }
                    const fator = linha.fatorConversao.trim();
                    if (fator && (!/^\d+(?:[.,]\d{1,3})?$/.test(fator) || Number(fator.replace(",", ".")) <= 0)) {
                        setErroVinculos("Informe um fator de conversão maior que zero (ex.: 20 para 1 maço = 20 unidades).");
                        setAbaAtual(2);
                        return null;
                    }
                    vinculosValidos.push({
                        fornecedorId: linha.fornecedor.id,
                        codigoReferencia: linha.codigoReferencia.trim() || null,
                        fatorConversao: fator ? Number(fator.replace(",", ".")) : null,
                    });
                }
                setErroVinculos("");
            }

            return {
                ...(!rapido ? { composto, ...(composicao ? { componentes: composicao } : {}) } : {}),
                ...(!rapido ? { fornecedorId: fornecedor?.id ?? null, categoriaId: classificacao.categoria?.id ?? null, subcategoriaId: classificacao.subcategoria?.id ?? null, marcaId: classificacao.marca?.id ?? null } : {}),
                ...(!rapido ? { fornecedoresAdicionais: vinculosValidos } : {}),
                codigoInterno: duplicando && codigoAutomatico ? null : formulario.codigoInterno.trim() || null,
                codigoBarras:
                    formulario.codigoBarras.trim() || null,
                ...(!rapido ? { ncm: formulario.ncm.trim() || null, cest: formulario.cest.trim() || null } : {}),
                nome: formulario.nome.trim(),
                descricao: formulario.descricao.trim() || null,
                unidadeMedida: formulario.unidadeMedida.trim(),
                precoCusto,
                precoVenda,
                estoqueMinimo: formulario.controlaEstoque
                    ? estoqueMinimo!
                    : 0,
                controlaEstoque: formulario.controlaEstoque,
                ativo: formulario.ativo,
            };
        }

        async function enviar(
            evento: FormEvent<HTMLFormElement>
        ) {
            evento.preventDefault();

            if (salvando || carregandoProduto || ocupado.current) return;

            const dados = validar();

            if (dados) {
                if (!rapido) { await onSalvar?.(dados, arquivoImagem, imagemRemovida); return; }
                ocupado.current = true; setSalvandoRapido(true); setErroRapido("");
                try { onSalvo?.(await cadastrarProduto(dados)); }
                catch (e) { setErroRapido(obterMensagemDaApi(e, "Não foi possível cadastrar o produto.")); }
                finally { ocupado.current = false; setSalvandoRapido(false); }
            }
        }

        return (
            <>
            <CadastroDialog
                aberto={aberto}
                variante={rapido ? "compact" : "full"}
                titulo={duplicando ? "Duplicar produto" : editando ? "Editar produto" : "Novo produto"}
                descricao={
                    rapido ? "Cadastro rápido: só o essencial." : duplicando
                        ? `Novo produto baseado em “${produto?.nome ?? "produto"}”. Revise os dados antes de criar.` : editando
                        ? "Revise os dados e salve as alterações."
                        : "Preencha os dados para cadastrar um produto."
                }
                salvando={salvando}
                desabilitarSalvar={carregandoProduto}
                textoSalvar={
                    rapido ? "Cadastrar e selecionar" : duplicando ? "Criar produto" : editando
                        ? "Salvar alterações"
                        : "Cadastrar produto"
                }
                onFechar={onFechar}
                onSubmit={enviar}
                navegacao={rapido ? undefined : (
                    <Tabs
                        value={abaAtual}
                        onChange={(_, valor) => setAbaAtual(valor)}
                        variant="scrollable"
                        scrollButtons="auto"
                        aria-label="Seções do cadastro de produto"
                        sx={{ px: { xs: 2, sm: 4 } }}
                    >
                        {ABAS.map((rotulo, indice) => (
                            <Tab key={rotulo} label={rotulo} id={`produto-aba-${indice}`}
                                aria-controls={`produto-painel-${indice}`} />
                        ))}
                    </Tabs>
                )}
            >
                {carregandoProduto ? (
                    <Box
                        sx={{
                            display: "grid",
                            minHeight: 280,
                            placeItems: "center",
                        }}
                    >
                        <CircularProgress size={32}/>
                    </Box>
                ) : (
                    <Stack spacing={2.25}>
                        {mensagemErro && (
                            <Alert severity="error">
                                {mensagemErro}
                            </Alert>
                        )}

                        {(rapido || abaAtual === 0) && <Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                {rapido ? "Cadastro rápido" : "Identificação"}
                            </Typography>

                            <Divider/>

                            <Box
                                sx={{
                                    display: "grid",
                                    gridTemplateColumns: {
                                        xs: "1fr",
                                        md: rapido ? "1fr" : "minmax(0, 1fr) 160px",
                                    },
                                    gap: 2,
                                    alignItems: "start",
                                }}
                            >
                                <Stack spacing={1.5}>
                                    <Box
                                        sx={{
                                            display: "grid",
                                            gridTemplateColumns: {
                                                xs: "1fr",
                                                sm: rapido ? "1fr" : "1fr 1fr",
                                            },
                                            gap: 1.5,
                                        }}
                                    >
                                        {duplicando && <Box sx={{ gridColumn: "1 / -1" }}>
                                            <Typography variant="body2" sx={{ mb: 0.5 }}>Código interno</Typography>
                                            <RadioGroup aria-label="Origem do código interno" value={codigoAutomatico ? "automatico" : "manual"} onChange={(_, valor) => { setCodigoAutomatico(valor === "automatico"); alterarCampo("codigoInterno", ""); }}>
                                                <FormControlLabel value="automatico" control={<Radio />} label="Gerar automaticamente" />
                                                <FormControlLabel value="manual" control={<Radio />} label="Informar manualmente" />
                                            </RadioGroup>
                                            {codigoAutomatico && <Typography variant="caption" color="text.secondary">O código será gerado ao salvar.</Typography>}
                                        </Box>}
                                        {!rapido && (!duplicando || !codigoAutomatico) && <TextField
                                            label="Código interno"
                                            name="codigoInterno"
                                            autoComplete="off"
                                            value={formulario.codigoInterno}
                                            onChange={(e) =>
                                                alterarCampo(
                                                    "codigoInterno",
                                                    e.target.value
                                                )
                                            }
                                            error={Boolean(
                                                erros.codigoInterno
                                            )}
                                            helperText={
                                                erros.codigoInterno || (duplicando ? "Use um código ainda não utilizado nesta empresa." : editando
                                                    ? produto?.codigoInterno?.trim()
                                                        ? "Deixe vazio para manter o código atual."
                                                        : "Produto legado sem código: informe um código para identificá-lo."
                                                    : "Opcional: gerado automaticamente ao cadastrar.")
                                            }
                                            slotProps={{
                                                htmlInput: {
                                                    maxLength: 60,
                                                    spellCheck: false,
                                                    translate: "no",
                                                },
                                            }}
                                        />}

                                        <TextField
                                            label="Código de barras"
                                            name="codigoBarras"
                                            autoComplete="off"
                                            value={formulario.codigoBarras}
                                            onChange={(e) =>
                                                alterarCampo(
                                                    "codigoBarras",
                                                    e.target.value
                                                )
                                            }
                                            error={Boolean(
                                                erros.codigoBarras
                                            )}
                                            helperText={
                                                erros.codigoBarras
                                            }
                                            slotProps={{
                                                htmlInput: {
                                                    maxLength: 60,
                                                },
                                            }}
                                        />
                                    </Box>

                                    <TextField
                                        required
                                        label="Nome"
                                        name="nome"
                                        autoComplete="off"
                                        autoFocus={!carregandoProduto && (rapido || abaAtual === 0)}
                                        value={formulario.nome}
                                        onChange={(e) =>
                                            alterarCampo(
                                                "nome",
                                                e.target.value
                                            )
                                        }
                                        error={Boolean(erros.nome)}
                                        helperText={erros.nome}
                                        slotProps={{
                                            htmlInput: {
                                                maxLength: 150,
                                            },
                                        }}
                                    />

                                    {!rapido && <ClassificacaoProdutoCampos valor={classificacao} onChange={setClassificacao} disabled={salvando} />}

                                    {!rapido && <TextField
                                        label="Descrição"
                                        name="descricao"
                                        autoComplete="off"
                                        value={formulario.descricao}
                                        onChange={(e) =>
                                            alterarCampo(
                                                "descricao",
                                                e.target.value
                                            )
                                        }
                                        error={Boolean(
                                            erros.descricao
                                        )}
                                        helperText={
                                            erros.descricao ??
                                            `${formulario.descricao.length}/2000`
                                        }
                                        multiline
                                        minRows={2}
                                        slotProps={{
                                            htmlInput: {
                                                maxLength: 2000,
                                            },
                                        }}
                                    />}
                                </Stack>

                                {!rapido && <Stack spacing={0.75}>
                                    <Box
                                        component="label"
                                        role="button"
                                        tabIndex={0}
                                        aria-label="Selecionar imagem do produto"
                                        onKeyDown={(evento) => {
                                            if (evento.key === "Enter" || evento.key === " ") {
                                                evento.preventDefault();
                                                evento.currentTarget.click();
                                            }
                                        }}
                                        sx={{
                                            width: "100%",
                                            aspectRatio: "1 / 1",
                                            border: "1px dashed",
                                            borderColor: "divider",
                                            borderRadius: 2,
                                            bgcolor: "action.hover",
                                            display: "flex",
                                            alignItems: "center",
                                            justifyContent: "center",
                                            overflow: "hidden",
                                            cursor: "pointer",
                                            transition: "0.2s",
                                            "&:hover": {
                                                bgcolor: "action.selected",
                                                borderColor: "primary.main",
                                            },
                                        }}
                                    >
                                        <input
                                            type="file"
                                            name="imagem"
                                            accept="image/*"
                                            hidden
                                            onChange={selecionarImagem}
                                        />

                                        {previewImagem ? (
                                            <Box
                                                component="img"
                                                src={previewImagem}
                                                alt="Imagem do produto"
                                                sx={{
                                                    width: "100%",
                                                    height: "100%",
                                                    objectFit: "cover",
                                                }}
                                            />
                                        ) : (
                                            <Typography
                                                variant="caption"
                                                color="text.secondary"
                                                align="center"
                                                sx={{px: 1.5}}
                                            >
                                                Clique para adicionar imagem
                                            </Typography>
                                        )}
                                    </Box>

                                    {arquivoImagem && (
                                        <Typography
                                            variant="caption"
                                            color="text.secondary"
                                            sx={{
                                                textAlign: "center",
                                                overflow: "hidden",
                                                textOverflow: "ellipsis",
                                                whiteSpace: "nowrap",
                                            }}
                                        >
                                            {arquivoImagem.name}
                                        </Typography>
                                    )}

                                    {previewImagem && (
                                        <Button
                                            type="button"
                                            size="small"
                                            aria-label="Remover imagem do produto"
                                            color="error"
                                            onClick={removerImagem}
                                            sx={{
                                                textTransform: "none",
                                            }}
                                        >
                                            Remover imagem
                                        </Button>
                                    )}
                                </Stack>}
                            </Box>
                        </Stack>}

                        {(rapido || abaAtual === 1) && <><Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                {rapido ? "Preços" : "Preços"}
                            </Typography>

                            <Divider/>

                            <Box
                                sx={{
                                    display: "grid",
                                    gridTemplateColumns: {
                                        xs: "1fr",
                                        sm: rapido ? "1fr 1fr" : "180px 1fr 1fr",
                                    },
                                    gap: 1.5,
                                }}
                            >
                                <TextField
                                    required
                                    label="Unidade de medida"
                                    name="unidadeMedida"
                                    autoComplete="off"
                                    value={formulario.unidadeMedida}
                                    onChange={(e) =>
                                        alterarCampo(
                                            "unidadeMedida",
                                            e.target.value.toUpperCase()
                                        )
                                    }
                                    error={Boolean(
                                        erros.unidadeMedida
                                    )}
                                    helperText={
                                        erros.unidadeMedida ??
                                        "Ex.: UN, KG, LT"
                                    }
                                    slotProps={{
                                        htmlInput: {
                                            maxLength: 10,
                                        },
                                    }}
                                />

                                <TextField
                                    label="Preço de custo"
                                    name="precoCusto"
                                    disabled={composto}
                                    autoComplete="off"
                                    value={formulario.precoCusto}
                                    onChange={(e) =>
                                        alterarCampo(
                                            "precoCusto",
                                            e.target.value
                                        )
                                    }
                                    error={Boolean(
                                        erros.precoCusto
                                    )}
                                    helperText={composto ? "Calculado pelos componentes." : erros.precoCusto}
                                    slotProps={{
                                        input: {
                                            startAdornment: (
                                                <Typography
                                                    sx={{mr: 1}}
                                                >
                                                    R$
                                                </Typography>
                                            ),
                                        },
                                        htmlInput: { inputMode: "decimal" },
                                    }}
                                />

                                <TextField
                                    required
                                    label="Preço de venda"
                                    name="precoVenda"
                                    autoComplete="off"
                                    value={formulario.precoVenda}
                                    onChange={(e) =>
                                        alterarCampo(
                                            "precoVenda",
                                            e.target.value
                                        )
                                    }
                                    error={Boolean(
                                        erros.precoVenda
                                    )}
                                    helperText={erros.precoVenda}
                                    slotProps={{
                                        input: {
                                            startAdornment: (
                                                <Typography
                                                    sx={{mr: 1}}
                                                >
                                                    R$
                                                </Typography>
                                            ),
                                        },
                                        htmlInput: { inputMode: "decimal" },
                                    }}
                                />
                            </Box>
                        </Stack>

                        {!rapido && <Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                Estoque
                            </Typography>

                            <Divider/>

                            <Box
                                sx={{
                                    display: "grid",
                                    gridTemplateColumns: {
                                        xs: "1fr",
                                        sm: "minmax(240px, .85fr) 1fr",
                                    },
                                    gap: 1.5,
                                    alignItems: "start",
                                }}
                            >
                                <Box
                                    sx={{
                                        display: "flex",
                                        alignItems: "center",
                                        justifyContent:
                                            "space-between",
                                        gap: 2,
                                        minHeight: 44,
                                        px: 1.5,
                                        border: 1,
                                        borderColor: "divider",
                                        borderRadius: 2,
                                    }}
                                >
                                    <Box>
                                        <Typography
                                            variant="body2"
                                            sx={{
                                                fontWeight: 650,
                                            }}
                                        >
                                            Controla estoque
                                        </Typography>

                                        <Typography
                                            variant="caption"
                                            color="text.secondary"
                                        >
                                            Habilita saldo e estoque mínimo.
                                        </Typography>
                                    </Box>

                                    <Switch
                                        disabled={composto}
                                        checked={
                                            composto || formulario.controlaEstoque
                                        }
                                        onChange={(e) =>
                                            alterarControlaEstoque(
                                                e.target.checked
                                            )
                                        }
                                        slotProps={{
                                            input: {
                                                name: "controlaEstoque",
                                                "aria-label":
                                                    "Controla estoque",
                                            },
                                        }}
                                    />
                                </Box>

                                <TextField
                                    label="Estoque mínimo"
                                    name="estoqueMinimo"
                                    autoComplete="off"
                                    value={formulario.estoqueMinimo}
                                    onChange={(e) =>
                                        alterarCampo(
                                            "estoqueMinimo",
                                            e.target.value
                                        )
                                    }
                                    error={Boolean(
                                        erros.estoqueMinimo
                                    )}
                                    helperText={
                                        erros.estoqueMinimo ??
                                        (formulario.controlaEstoque
                                            ? "Até 3 casas decimais"
                                            : "Não utilizado sem controle de estoque")
                                    }
                                    disabled={
                                        !formulario.controlaEstoque
                                    }
                                    slotProps={{ htmlInput: { inputMode: "decimal" } }}
                                />
                            </Box>

                            {(kitsDependentes?.length ?? 0) > 0 && formulario.controlaEstoque && (
                                <Alert severity="warning">
                                    Este produto é componente de {kitsDependentes!.length === 1
                                        ? "1 Kit/Combo"
                                        : `${kitsDependentes!.length} Kits/Combos`}:{" "}
                                    {kitsDependentes!.map((k) => k.nome).join(", ")}.
                                    {" "}Desligar o controle de estoque impede a baixa automática desses kits na venda.
                                </Alert>
                            )}

                            <Box
                                sx={{
                                    px: 1.5,
                                    py: 1.25,
                                    bgcolor: "action.hover",
                                    borderRadius: 2,
                                }}
                            >
                                <Typography variant="body2">
                                    <strong>Saldo atual:</strong>{" "}
                                    {produto && !duplicando
                                        ? numeroParaCampo(
                                            produto.estoqueAtual,
                                            3
                                        )
                                        : "0,000"}
                                </Typography>

                                <Typography
                                    variant="caption"
                                    color="text.secondary"
                                >
                                    Alterações de saldo são feitas
                                    exclusivamente pela tela de Estoque.
                                </Typography>
                            </Box>
                        </Stack>}

                        {!rapido && <Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                Status
                            </Typography>

                            <Divider/>

                            <Box
                                sx={{
                                    display: "flex",
                                    alignItems: "center",
                                    justifyContent:
                                        "space-between",
                                    gap: 2,
                                    minHeight: 44,
                                    px: 1.5,
                                    border: 1,
                                    borderColor: "divider",
                                    borderRadius: 2,
                                }}
                            >
                                <Box>
                                    <Typography
                                        variant="body2"
                                        sx={{fontWeight: 650}}
                                    >
                                        Produto ativo
                                    </Typography>

                                    <Typography
                                        variant="caption"
                                        color="text.secondary"
                                    >
                                        Produtos inativos deixam de aparecer nas operações.
                                    </Typography>
                                </Box>

                                <Switch
                                    checked={formulario.ativo}
                                    onChange={(e) =>
                                        alterarAtivo(
                                            e.target.checked
                                        )
                                    }
                                    slotProps={{
                                        input: {
                                            name: "ativo",
                                            "aria-label":
                                                "Produto ativo",
                                        },
                                    }}
                                />
                            </Box>
                        </Stack>}
                        </>}

                        {abaAtual === 2 && !rapido && <Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                Fornecedores
                            </Typography>

                            <Divider/>

                            <FornecedorAutocomplete value={fornecedor} onChange={(f) => { setFornecedor(f); setErroVinculos(""); }}
                                label="Fornecedor principal" disabled={salvando} mostrarErroConsulta
                                helperText={produto?.fornecedor?.id === fornecedor?.id && produto?.fornecedor?.ativo === false
                                    ? "Fornecedor inativo. O vínculo atual pode ser mantido ou removido."
                                    : "Opcional. Pesquise um fornecedor cadastrado ou limpe para remover o vínculo."} />

                            <Box>
                                <Typography variant="body2" sx={{ fontWeight: 650 }}>
                                    Fornecedores adicionais
                                </Typography>
                                <Typography variant="caption" color="text.secondary">
                                    Código de referência/fabricante e fator de conversão que cada fornecedor usa para este produto.
                                </Typography>
                            </Box>

                            {vinculos.length === 0 && (
                                <Typography variant="body2" color="text.secondary">
                                    Nenhum fornecedor adicional vinculado.
                                </Typography>
                            )}

                            {vinculos.map((linha, indice) => (
                                <Box key={indice}
                                    sx={{
                                        display: "grid",
                                        gridTemplateColumns: {
                                            xs: "1fr",
                                            sm: "minmax(0, 1fr) 210px 140px 40px",
                                        },
                                        gap: 1.5,
                                        alignItems: "start",
                                    }}>
                                    <FornecedorAutocomplete
                                        value={linha.fornecedor}
                                        onChange={(f) => atualizarVinculo(indice, { fornecedor: f })}
                                        label={`Fornecedor adicional ${indice + 1}`}
                                        disabled={salvando}
                                        mostrarErroConsulta
                                    />
                                    <TextField
                                        label="Cód. referência/fabricante"
                                        name={`codigoReferencia-${indice}`}
                                        autoComplete="off"
                                        value={linha.codigoReferencia}
                                        onChange={(e) => atualizarVinculo(indice, { codigoReferencia: e.target.value })}
                                        disabled={salvando}
                                        slotProps={{ htmlInput: { maxLength: 60 } }}
                                    />
                                    <TextField
                                        label="Qtd. por embalagem"
                                        name={`fatorConversao-${indice}`}
                                        autoComplete="off"
                                        value={linha.fatorConversao}
                                        onChange={(e) => atualizarVinculo(indice, { fatorConversao: e.target.value })}
                                        disabled={salvando}
                                        helperText="1 emb. = X un."
                                        slotProps={{ htmlInput: { inputMode: "decimal" } }}
                                    />
                                    <IconButton
                                        aria-label={`Remover fornecedor adicional ${indice + 1}`}
                                        onClick={() => removerVinculo(indice)}
                                        disabled={salvando}
                                        sx={{ mt: 0.25 }}
                                    >
                                        <DeleteOutlineRoundedIcon />
                                    </IconButton>
                                </Box>
                            ))}

                            <Box>
                                <Button
                                    type="button"
                                    variant="outlined"
                                    size="small"
                                    startIcon={<AddRoundedIcon />}
                                    onClick={adicionarVinculo}
                                    disabled={salvando}
                                    sx={{ textTransform: "none" }}
                                >
                                    Adicionar fornecedor
                                </Button>
                            </Box>

                            {erroVinculos && (
                                <Alert severity="error">
                                    {erroVinculos}
                                </Alert>
                            )}
                        </Stack>}

                        {abaAtual === 3 && !rapido && <Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                Kit/Combo
                            </Typography>

                            <Divider/>

                            <FormControlLabel control={<Switch checked={composto} disabled={(!!produto && !duplicando) || salvando || !suportaKit} onChange={(_, v) => setComposto(v)} />} label="Produto composto (Kit/Combo)" />
                            {duplicando && produto?.composto && <Alert severity="info">A composição e o custo calculado do Kit/Combo original não são copiados. Configure os componentes antes de criar um novo Kit/Combo.</Alert>}
                            {!suportaKit && !produto && <Typography variant="caption" color="text.secondary">Kit/Combo requer API atualizada e disponível. Reabra o formulário após a atualização.</Typography>}
                            {composto && <ComposicaoProdutoCampos produtoId={duplicando ? undefined : produto?.id} valor={componentes} onChange={setComponentes} disabled={salvando} />}
                        </Stack>}

                        {abaAtual === 4 && !rapido && <Stack spacing={1.5}>
                            <Typography variant="subtitle2">
                                Fiscal
                            </Typography>

                            <Divider/>

                            <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr" }, gap: 1.5 }}>
                                <TextField label="NCM" name="ncm" autoComplete="off" value={formulario.ncm} onChange={e => alterarCampo("ncm", e.target.value)} error={Boolean(erros.ncm)} helperText={erros.ncm} slotProps={{ htmlInput: { maxLength: 8, inputMode: "numeric" } }} />
                                <TextField label="CEST" name="cest" autoComplete="off" value={formulario.cest} onChange={e => alterarCampo("cest", e.target.value)} error={Boolean(erros.cest)} helperText={erros.cest} slotProps={{ htmlInput: { maxLength: 7, inputMode: "numeric" } }} />
                            </Box>
                        </Stack>}
                    </Stack>
                )}
            </CadastroDialog>
            <DialogoConfirmacaoCritica
                pendencia={pendencia}
                kitsDependentes={kitsDependentes}
                onConfirmar={confirmarPendencia}
                onCancelar={() => setPendencia(null)}
            />
            </>
        );
    }

    function DialogoConfirmacaoCritica({
        pendencia,
        kitsDependentes,
        onConfirmar,
        onCancelar,
    }: {
        pendencia: { campo: "controlaEstoque" | "ativo"; valor: boolean } | null;
        kitsDependentes: KitDependente[] | null;
        onConfirmar: () => void;
        onCancelar: () => void;
    }) {
        const kits = kitsDependentes ?? [];
        const desligandoEstoque = pendencia?.campo === "controlaEstoque";

        return (
            <Dialog
                open={pendencia !== null}
                onClose={onCancelar}
                fullWidth
                maxWidth="sm"
                aria-labelledby="produto-alerta-critico-titulo"
            >
                <DialogTitle id="produto-alerta-critico-titulo">
                    {desligandoEstoque ? "Desativar controle de estoque?" : "Inativar produto?"}
                </DialogTitle>
                <DialogContent>
                    <Stack spacing={1.5}>
                        <Typography variant="body2">
                            {desligandoEstoque
                                ? "O produto deixará de controlar saldo e estoque mínimo, e as vendas não vão mais baixar o estoque dele."
                                : "Produtos inativos deixam de aparecer no PDV, nas buscas e nas novas operações."}
                        </Typography>
                        {kits.length > 0 && (
                            <Alert severity="warning">
                                Este produto é componente de{" "}
                                {kits.length === 1 ? "1 Kit/Combo" : `${kits.length} Kits/Combos`}:{" "}
                                {kits.map((k) => k.nome).join(", ")}.
                                {desligandoEstoque
                                    ? " Desativar o controle de estoque fará a venda desses kits falhar até que a composição seja revisada."
                                    : " A venda desses kits será bloqueada enquanto o componente estiver inativo."}
                            </Alert>
                        )}
                        <Typography variant="caption" color="text.secondary">
                            O cadastro pode ser ajustado novamente a qualquer momento.
                        </Typography>
                    </Stack>
                </DialogContent>
                <DialogActions sx={{ flexWrap: "wrap", gap: 1 }}>
                    <Button onClick={onCancelar}>Manter como está</Button>
                    <Button onClick={onConfirmar} color="warning" variant="contained">
                        {desligandoEstoque ? "Entendi, desativar controle" : "Entendi, inativar"}
                    </Button>
                </DialogActions>
            </Dialog>
        );
    }

    export default ProdutoForm;

